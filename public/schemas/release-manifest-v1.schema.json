{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latexsnipper.interknot.dpdns.org/schemas/release-manifest-v1.schema.json",
  "title": "LaTeXSnipper release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "version", "channel", "releaseNotesUrl", "assets"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "product": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "minLength": 1 },
    "publishedAt": { "type": "string" },
    "releaseNotesUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/SakuraMathcraft/LaTeXSnipper/releases/tag/" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "label", "architecture", "requirements", "href", "sha256", "size"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "platform": { "enum": ["windows", "linux", "macos"] },
          "label": { "type": "string", "minLength": 1 },
          "architecture": { "type": "string", "minLength": 1 },
          "requirements": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "pattern": "^/dl/[A-Za-z0-9._-]+$" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "size": { "type": "string" }
        }
      }
    }
  }
}
